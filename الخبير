<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الخبير لفحص الهواتف | المنصة الذكية لفحص الأجهزة المستعملة</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary-bg: #0f172a;
            --card-bg: #1e293b;
            --accent-green: #10b981;
            --accent-blue: #3b82f6;
            --text-color: #f8fafc;
            --text-muted: #94a3b8;
            --border-color: #334155;
            --radius: 12px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Cairo', sans-serif;
        }

        body {
            background-color: var(--primary-bg);
            color: var(--text-color);
            direction: rtl;
            line-height: 1.6;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        .navbar {
            background: rgba(30, 41, 59, 0.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 100;
            padding: 1rem 0;
        }

        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1.25rem;
            font-weight: 800;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 1.5rem;
        }

        nav a {
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 600;
            transition: 0.2s;
        }

        nav a:hover {
            color: var(--accent-green);
        }

        .hero {
            padding: 4rem 0 3rem;
            text-align: center;
            background: radial-gradient(circle at center, rgba(59, 130, 246, 0.1), transparent);
        }

        .hero h1 {
            font-size: 2.2rem;
            font-weight: 800;
            margin-bottom: 1rem;
        }

        .hero p {
            color: var(--text-muted);
            font-size: 1.1rem;
            max-width: 600px;
            margin: 0 auto 2rem;
        }

        .section {
            margin: 3rem 0;
        }

        .section-title {
            font-size: 1.5rem;
            margin-bottom: 1.5rem;
            border-right: 4px solid var(--accent-green);
            padding-right: 0.75rem;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.5rem;
        }

        .card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: var(--radius);
            padding: 1.5rem;
        }

        .card h3 {
            margin-bottom: 0.5rem;
        }

        .card p {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-bottom: 1rem;
        }

        .status {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            background: rgba(148, 163, 184, 0.1);
            color: var(--text-muted);
            border-radius: 20px;
            font-size: 0.85rem;
            margin-bottom: 1rem;
            font-weight: 600;
        }

        .status.success {
            background: rgba(16, 185, 129, 0.15);
            color: var(--accent-green);
        }

        .btn {
            display: inline-block;
            padding: 0.75rem 1.25rem;
            border-radius: var(--radius);
            border: none;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            text-align: center;
            width: 100%;
            transition: 0.2s;
        }

        .btn-primary {
            background: var(--accent-green);
            color: white;
            width: auto;
        }

        .btn-primary:hover {
            background: #059669;
        }

        .btn-secondary {
            background: var(--accent-blue);
            color: white;
        }

        .btn-secondary:hover {
            background: #2563eb;
        }

        .checklist-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 0;
            border-bottom: 1px solid var(--border-color);
        }

        .checklist-item:last-child {
            border-bottom: none;
        }

        .overlay {
            position: fixed;
            inset: 0;
            background: black;
            z-index: 1000;
            display: none;
        }

        .overlay.active {
            display: flex;
        }

        .touch-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            grid-template-rows: repeat(10, 1fr);
            width: 100vw;
            height: 100vh;
        }

        .touch-cell {
            border: 1px solid rgba(255, 255, 255, 0.05);
            background: #000;
        }

        .touch-cell.touched {
            background: var(--accent-green);
        }

        footer {
            border-top: 1px solid var(--border-color);
            padding: 2rem 0;
            margin-top: 4rem;
            color: var(--text-muted);
        }

        .text-center {
            text-align: center;
        }

        @media print {
            .navbar, .hero, .btn, footer, .checklist-item input {
                display: none !important;
            }
            body {
                background: white;
                color: black;
            }
            .card {
                border: 1px solid #ccc;
                background: white;
                color: black;
            }
        }
    </style>
</head>
<body>

    <header class="navbar">
        <div class="container nav-container">
            <div class="logo">
                <div class="logo-icon">📱</div>
                <span>الخبير لفحص الهواتف</span>
            </div>
            <nav>
                <ul>
                    <li><a href="#hero">الرئيسية</a></li>
                    <li><a href="#tests">الفحوصات</a></li>
                    <li><a href="#checklist">الفحص اليدوي</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <section id="hero" class="hero">
        <div class="container">
            <h1>افحص هاتفك المستعمل بدقة قبل الشراء</h1>
            <p>منصة برمجية متكاملة تتيح لك اختبار الشاشة، اللمس، السماعات، والكاميرا فورياً من المتصفح.</p>
            <a href="#tests" class="btn btn-primary">ابدأ الفحص الشامل</a>
        </div>
    </section>

    <main class="container">
        <section id="tests" class="section">
            <h2 class="section-title">الأدوات التفاعلية الحية</h2>
            <div class="grid">
                
                <div class="card">
                    <h3>🖥️ فحص الشاشة والبكسلات</h3>
                    <p>اختبار الألوان الخمسة الأساسية للكشف عن البكسلات الميتة والتطبيع.</p>
                    <div class="status" id="screenStatus">لم يتم الفحص</div>
                    <button class="btn btn-secondary" onclick="startScreenTest()">بدء فحص الشاشة</button>
                </div>

                <div class="card">
                    <h3>👆 فحص استجابة اللمس</h3>
                    <p>شبكة تفاعلية لتجربة اللمس على كامل أجزاء وزوايا الشاشة.</p>
                    <div class="status" id="touchStatus">لم يتم الفحص</div>
                    <button class="btn btn-secondary" onclick="startTouchTest()">بدء فحص اللمس</button>
                </div>

                <div class="card">
                    <h3>🔊 فحص السماعة والترددات</h3>
                    <p>إصدار موجة صوتية ناعمة بنغمة 440Hz لاختبار نقاء الصوت.</p>
                    <div class="status" id="audioStatus">لم يتم الفحص</div>
                    <button class="btn btn-secondary" onclick="startAudioTest()">اختبار الصوت</button>
                </div>

                <div class="card">
                    <h3>📳 فحص محرك الهزاز</h3>
                    <p>استدعاء نبضات متقطعة للتحقق من سلامة محرك الاهتزاز.</p>
                    <div class="status" id="vibeStatus">لم يتم الفحص</div>
                    <button class="btn btn-secondary" onclick="startVibrationTest()">اختبار الهزاز</button>
                </div>

                <div class="card">
                    <h3>📷 فحص الكاميرا والمايك</h3>
                    <p>فتح بث مباشر للكاميرا واختبار الميكروفون المدمج.</p>
                    <div class="status" id="cameraStatus">لم يتم الفحص</div>
                    <button class="btn btn-secondary" onclick="startCameraTest()">فتح الكاميرا والمايك</button>
                </div>

            </div>
            
            <video id="cameraPreview" autoplay playsinline style="display:none; width:100%; max-width:400px; margin: 1.5rem auto; border-radius: 12px;"></video>
        </section>

        <section id="checklist" class="section">
            <h2 class="section-title">قائمة الفحص اليدوي (Checklist)</h2>
            <div class="card">
                <div class="checklist-item">
                    <input type="checkbox" id="chk1">
                    <label for="chk1">التأكد من خروج الجهاز من حساب iCloud / Google Account كلياً.</label>
                </div>
                <div class="checklist-item">
                    <input type="checkbox" id="chk2">
                    <label for="chk2">فحص منافذ الشحن واستجابة أزرار الصوت والباور.</label>
                </div>
                <div class="checklist-item">
                    <input type="checkbox" id="chk3">
                    <label for="chk3">مطابقة رقم IMEI مع الكرتونة عبر إدخال الكود (#06#*).</label>
                </div>
            </div>
        </section>

        <section id="report" class="section">
            <h2 class="section-title">التقرير النهائي</h2>
            <div class="card text-center">
                <p>اضغط على الزر أدناه لتوليد تقرير شامل قابل للطباعة.</p>
                <button class="btn btn-primary" onclick="generateReport()">إصدار تقرير الفحص</button>
                <div id="reportOutput"></div>
            </div>
        </section>
    </main>

    <div id="screenOverlay" class="overlay" onclick="nextColor()"></div>
    
    <div id="touchOverlay" class="overlay">
        <div id="touchGrid" class="touch-grid"></div>
    </div>

    <footer>
        <div class="container text-center">
            <p>© 2026 الخبير لفحص الهواتف - جميع الحقوق محفوظة.</p>
        </div>
    </footer>

    <script>
        const results = {
            screen: false,
            touch: false,
            audio: false,
            vibration: false,
            camera: false
        };

        const colors = ['#ff0000', '#00ff00', '#0000ff', '#ffffff', '#000000'];
        let colorIndex = 0;

        function startScreenTest() {
            const overlay = document.getElementById('screenOverlay');
            colorIndex = 0;
            overlay.style.backgroundColor = colors[colorIndex];
            overlay.classList.add('active');
        }

        function nextColor() {
            colorIndex++;
            const overlay = document.getElementById('screenOverlay');
            if (colorIndex < colors.length) {
                overlay.style.backgroundColor = colors[colorIndex];
            } else {
                overlay.classList.remove('active');
                results.screen = true;
                updateStatus('screenStatus', 'تم الفحص بنجاح ✓');
            }
        }

        function startTouchTest() {
            const overlay = document.getElementById('touchOverlay');
            const grid = document.getElementById('touchGrid');
            grid.innerHTML = '';
            overlay.classList.add('active');

            const totalCells = 60;
            let touched = 0;

            for (let i = 0; i < totalCells; i++) {
                const cell = document.createElement('div');
                cell.className = 'touch-cell';

                const mark = (e) => {
                    e.preventDefault();
                    if (!cell.classList.contains('touched')) {
                        cell.classList.add('touched');
                        touched++;
                        if (touched === totalCells) {
                            setTimeout(() => {
                                overlay.classList.remove('active');
                                results.touch = true;
                                updateStatus('touchStatus', 'تم الفحص بنجاح ✓');
                            }, 200);
                        }
                    }
                };

                cell.addEventListener('touchstart', mark);
                cell.addEventListener('mouseover', mark);
                grid.appendChild(cell);
            }
        }

        function startAudioTest() {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                osc.type = 'sine';
                osc.frequency.value = 440;
                osc.connect(ctx.destination);
                osc.start();
                setTimeout(() => {
                    osc.stop();
                    ctx.close();
                    results.audio = true;
                    updateStatus('audioStatus', 'تم الفحص بنجاح ✓');
                }, 1500);
            } catch (e) {
                alert('غير مدعوم على هذا المتصفح');
            }
        }

        function startVibrationTest() {
            if ('vibrate' in navigator) {
                navigator.vibrate([200, 100, 200]);
                results.vibration = true;
                updateStatus('vibeStatus', 'تم الفحص بنجاح ✓');
            } else {
                alert('خاصية الهزاز غير مدعومة على المتصفح');
            }
        }

        async function startCameraTest() {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
                const video = document.getElementById('cameraPreview');
                video.srcObject = stream;
                video.style.display = 'block';
                results.camera = true;
                updateStatus('cameraStatus', 'تم الفحص بنجاح ✓');
            } catch (e) {
                alert('يرجى السماح بصلاحيات الكاميرا والمايك');
            }
        }

        function updateStatus(id, text) {
            const elem = document.getElementById(id);
            elem.textContent = text;
            elem.classList.add('success');
        }

        function generateReport() {
            const passedHardware = Object.values(results).filter(Boolean).length;
            const manualChecks = document.querySelectorAll('#checklist input[type="checkbox"]:checked').length;
            
            const score = Math.round(((passedHardware + manualChecks) / 8) * 100);

            const output = document.getElementById('reportOutput');
            output.innerHTML = `
                <div style="margin-top: 1.5rem; padding: 1rem; border: 1px solid var(--accent-green); border-radius: 8px;">
                    <h3 style="color: var(--accent-green)">نسبة سلامة الهاتف: ${score}%</h3>
                    <p style="margin-top: 0.5rem">تم اجتياز ${passedHardware} اختبارات أجهزة و ${manualChecks} فحوصات يدوية.</p>
                    <button class="btn btn-primary" onclick="window.print()" style="margin-top: 1rem;">طباعة التقرير (PDF)</button>
                </div>
            `;
        }
    </script>
</body>
</html>
